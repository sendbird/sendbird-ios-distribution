# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/*.plist
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcworkspace/contents.xcworkspacedata
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata

# Xcode user-specific files
*.xcuserstate
*.xcuserdata

# CocoaPods
*/Pods/
*/Podfile.lock

# Build directories
DerivedData/
build/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Local testing directories - keep local only
TestPod/
BAK/

# Local CocoaPods artifacts
LocalTest/Pods/
LocalTest/Podfile.lock
LocalTest/*.xcworkspace
# 스모크 테스트가 남기는 산출물. Core.xcframework 사본만 100MB 가 넘는다.
LocalTest/build/
LocalTest/*.xcarchive/
LocalTest/*.xcodeproj/
LocalTest/CoreLocal/*.xcframework/
LocalTest/*.log

# Keep example workspace contents
!LocalTest/*.xcworkspace/contents.xcworkspacedata
.build
Package.resolved
.swiftpm/

# XcodeGen 이 생성하는 바이너리 빌드용 프로젝트 (scripts/build_xcframeworks.sh)
SendbirdBinaryFrameworks.xcodeproj/
